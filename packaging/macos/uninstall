#!/bin/sh
# Removes plaa and its capture access helper. The access_bpf group stays,
# as triib and Wireshark may use it too.
#
#   sudo "/Library/Application Support/plaa/uninstall"
daemon=/Library/LaunchDaemons/run.plaa.bpf.plist
launchctl bootout system "$daemon" 2>/dev/null
rm -f "$daemon"
rm -rf /Applications/plaa.app "/Library/Application Support/plaa"
pkgutil --forget run.plaa >/dev/null 2>&1
exit 0
