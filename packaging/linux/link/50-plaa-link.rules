// Lets the person at the computer run plaa-link@, which keeps the frames
// plaa sends on an interface on its first transmit queue, and EEE and
// PAUSE off its link, as plaa does as its entity starts there.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb");
    if (/^plaa-link@[A-Za-z0-9_.-]+\.service$/.test(unit) &&
        (verb === "start" || verb === "restart")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
