[Unit]
Description=ptp4l running gPTP on %i for plaa
Documentation=man:ptp4l(8)
After=network.target
# plaa starts it where no ptp4l runs on the interface it sends AVB streams
# from, and plaa-ptp4l-lite@ in its place in AVB Lite. triib's ptp4l
# serves plaa as well: where one of triib's starts, this one stops.
Conflicts=plaa-ptp4l-lite@%i.service triib-ptp4l-gptp@%i.service triib-ptp4l-lite@%i.service

[Service]
# Every CPU's frames go out on the interface's first transmit queue. A
# card with several, as the Intel I210 has four, otherwise spreads frames
# over them by a hash of their first octets, a stream's own sequence
# number among them, and they leave out of order as the queues drain.
ExecStartPre=-/bin/sh -c '\
    for queue in /sys/class/net/"$$1"/queues/tx-*; do \
        echo 0 >"$$queue/xps_cpus"; done 2>/dev/null; \
    cat /proc/irq/default_smp_affinity \
        >"/sys/class/net/$$1/queues/tx-0/xps_cpus" 2>/dev/null; true' sh %i
# linuxptp 4 sends PTP 2.1, and some AVB switches, as PreSonus's, ignore
# its Pdelay_Req for it. From 4.2 it can send 2.0, as 802.1AS-2011 has,
# and it is told to wherever it knows the option.
ExecStart=/bin/sh -c '\
    minor=; ptp4l --ptp_minor_version 0 -v >/dev/null 2>&1 && \
        minor="--ptp_minor_version 0"; \
    exec ptp4l -f /usr/share/plaa/ptp4l-gptp.cfg -i "$$1" $$minor' sh %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
