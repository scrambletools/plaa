[Unit]
Description=ptp4l running the AVB Lite PTP profile on %i for plaa
Documentation=man:ptp4l(8)
After=network.target
# plaa moves ptp4l to this one from plaa-ptp4l@ as its entity falls back
# to AVB Lite, and back as the link comes up again. triib's ptp4l serves
# plaa as well: where one of triib's starts, this one stops.
Conflicts=plaa-ptp4l@%i.service triib-ptp4l-gptp@%i.service triib-ptp4l-lite@%i.service

[Service]
# Every CPU's frames go out on the interface's first transmit queue, as
# plaa-ptp4l@ has them, so a stream's frames leave in order.
ExecStartPre=-/bin/sh -c '\
    for queue in /sys/class/net/"$$1"/queues/tx-*; do \
        echo 0 >"$$queue/xps_cpus"; done 2>/dev/null; \
    cat /proc/irq/default_smp_affinity \
        >"/sys/class/net/$$1/queues/tx-0/xps_cpus" 2>/dev/null; true' sh %i
ExecStart=ptp4l -f /usr/share/plaa/ptp4l-lite.cfg -i %i
Restart=on-failure
RestartSec=2
