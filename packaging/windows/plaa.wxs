<!--
  plaa's Windows installer, built with WiX 5 by packaging/windows/build.ps1,
  which also writes libraries.wxs, the FFmpeg DLLs plaa.exe loads:

    wix build packaging\windows\plaa.wxs libraries.wxs -ext WixToolset.UI.wixext
      -ext WixToolset.Util.wixext -d Version=0.1.0 -d Source=dist -o plaa.msi

  It installs for the current user, with no administrator prompt, into
  %LOCALAPPDATA%\Programs\plaa, adds plaa to the Start menu, offers it in
  Open With for video and audio files without taking them over, and gives
  it a page in Settings' Default apps, which Settings in plaa opens.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?define AppKey = Software\Scramble Tools\plaa ?>
  <?define OpenWith = Software\Classes\Applications\plaa.exe ?>
  <!-- The file types plaa is offered for, which default_app.rs counts as
       Settings shows how many open with plaa. -->
  <?define VideoExtensions = .3g2;.3gp;.avi;.flv;.m2ts;.m4v;.mkv;.mov;.mp4;.mpeg;.mpg;.mts;.ogv;.ts;.webm;.wmv ?>
  <?define AudioExtensions = .aac;.ac3;.aif;.aiff;.ape;.dts;.flac;.m4a;.mka;.mp3;.mpc;.oga;.ogg;.opus;.wav;.wma;.wv ?>
  <?define PlaylistExtensions = .m3u;.m3u8;.pls ?>

  <Package Name="plaa" Manufacturer="Scramble Tools" Version="$(var.Version)"
           UpgradeCode="9e4b7c21-3a6d-4f58-b1c2-7d8e0f4a5b63" Scope="perUser"
           Language="1033" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of plaa is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <?ifdef Icon ?>
    <Icon Id="plaa.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="plaa.ico" />
    <?endif ?>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/scrambletools/plaa" />
    <Property Id="ARPHELPLINK" Value="https://github.com/scrambletools/plaa" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="Programs" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="plaa" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components are kept track of by a value under the app's
         key rather than by their files, so those with files need GUIDs of
         their own. Keep them: changing one breaks upgrades. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="5b2e8f14-c7a9-4d36-8e01-3f6a9c2d7b45">
        <File Id="plaa.exe" Source="$(var.Source)\plaa.exe" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemovePrograms" Directory="Programs" On="uninstall" />
      </Component>
      <!-- Open With: plaa among the programs Windows offers for these
           files, which stay with whatever opens them now. -->
      <Component Id="OpenWith" Guid="c41d7a9e-2f6b-4b58-9a3c-8e5d1f7b2a60">
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)" Name="FriendlyAppName" Type="string" Value="plaa" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot;,0" />
        <?foreach Extension in $(var.VideoExtensions) ?>
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)\SupportedTypes" Name="$(Extension)" Type="string" Value="" />
        <?endforeach ?>
        <?foreach Extension in $(var.AudioExtensions) ?>
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)\SupportedTypes" Name="$(Extension)" Type="string" Value="" />
        <?endforeach ?>
        <?foreach Extension in $(var.PlaylistExtensions) ?>
        <RegistryValue Root="HKCU" Key="$(var.OpenWith)\SupportedTypes" Name="$(Extension)" Type="string" Value="" />
        <?endforeach ?>
      </Component>
      <!-- Default apps: plaa's page in Settings, where the user can make it
           the default for these files, as Windows lets only the user do,
           with file types of plaa's own naming them. -->
      <Component Id="DefaultApps" Guid="29724707-b4df-46a8-97df-4f24e2faf2ab">
        <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="DefaultApps" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)\Capabilities" Name="ApplicationName" Type="string" Value="plaa" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)\Capabilities" Name="ApplicationDescription" Type="string" Value="Play video and audio files and streams" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="plaa" Type="string" Value="$(var.AppKey)\Capabilities" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Video" Type="string" Value="Video (plaa)" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Video\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot;,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Video\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Audio" Type="string" Value="Audio (plaa)" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Audio\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot;,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Audio\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot; &quot;%1&quot;" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Playlist" Type="string" Value="Playlist (plaa)" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Playlist\DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot;,0" />
        <RegistryValue Root="HKCU" Key="Software\Classes\plaa.Playlist\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]plaa.exe&quot; &quot;%1&quot;" />
        <?foreach Extension in $(var.VideoExtensions) ?>
        <RegistryValue Root="HKCU" Key="Software\Classes\$(Extension)\OpenWithProgids" Name="plaa.Video" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)\Capabilities\FileAssociations" Name="$(Extension)" Type="string" Value="plaa.Video" />
        <?endforeach ?>
        <?foreach Extension in $(var.AudioExtensions) ?>
        <RegistryValue Root="HKCU" Key="Software\Classes\$(Extension)\OpenWithProgids" Name="plaa.Audio" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)\Capabilities\FileAssociations" Name="$(Extension)" Type="string" Value="plaa.Audio" />
        <?endforeach ?>
        <?foreach Extension in $(var.PlaylistExtensions) ?>
        <RegistryValue Root="HKCU" Key="Software\Classes\$(Extension)\OpenWithProgids" Name="plaa.Playlist" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="$(var.AppKey)\Capabilities\FileAssociations" Name="$(Extension)" Type="string" Value="plaa.Playlist" />
        <?endforeach ?>
      </Component>
      <ComponentGroupRef Id="Libraries" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ProgramMenuFolder">
      <?ifdef Icon ?>
      <Shortcut Id="StartMenuShortcut" Name="plaa" Description="Play video and audio files and streams"
                Target="[INSTALLFOLDER]plaa.exe" WorkingDirectory="INSTALLFOLDER" Icon="plaa.ico" />
      <?else ?>
      <Shortcut Id="StartMenuShortcut" Name="plaa" Description="Play video and audio files and streams"
                Target="[INSTALLFOLDER]plaa.exe" WorkingDirectory="INSTALLFOLDER" />
      <?endif ?>
      <RegistryValue Root="HKCU" Key="$(var.AppKey)" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- One page with the license, then the last page's choice to open
         plaa. The program's path is known only once costing is done. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open plaa" />
    <SetProperty Id="WixShellExecTarget" Action="OpenPlaaTarget" Sequence="ui" After="CostFinalize"
                 Value="[#plaa.exe]" />
    <CustomAction Id="OpenAtFinish" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenAtFinish"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
