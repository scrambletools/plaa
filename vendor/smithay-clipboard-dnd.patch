+
+fn stop(shared: &Shared) {
+    let _ = shared.request_sender.send(worker::Command::Exit);
+    let thread = shared.thread.lock().unwrap_or_else(PoisonError::into_inner).take();
+    if let Some(thread) = thread {
+        let _ = thread.join();
